{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "fmt": "prettier --write 'src' '.storybook/*.ts' '*.ts' '*.json' 'index.html' 'eslint.config.js'",
    "fmt:check": "prettier --check 'src' '.storybook/*.ts' '*.ts' '*.json' 'index.html' 'eslint.config.js'",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@popperjs/core": "2.11.8",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.16.0",
    "bootstrap": "5.3.2",
    "chart.js": "4.5.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/react-vite": "^10.5.9",
    "@types/bootstrap": "5.2.11",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-storybook": "^10.5.9",
    "globals": "^17.6.0",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "prettier": "^3.9.5",
    "storybook": "^10.5.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.16"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
